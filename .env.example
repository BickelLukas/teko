# Copy this file to .env in the repo root, then edit as needed.
# cp .env.example .env

# Backend HTTP port (default: 3000)
PORT=3000

# Set BOTH to enable dev-mode auth (local development only).
# The server refuses to start with DEV_MODE=true if NODE_ENV=production.
NODE_ENV=development
DEV_MODE=false

# Dev-mode mock user (only used when DEV_MODE=true)
DEV_USER_ID=dev-alice
DEV_USER_NAME=Alice

# SQLite database path (relative to backend package dir, created if missing)
DB_PATH=./data/teko.db
