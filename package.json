{
  "name": "teko",
  "version": "0.0.16",
  "private": true,
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "src/backend",
    "src/frontend",
    "src/shared"
  ],
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors cyan,magenta \"yarn workspace @teko/backend dev\" \"yarn workspace @teko/frontend dev\"",
    "build": "yarn workspaces foreach -A --topological-dev run build && node -e \"const{cpSync}=require('fs');cpSync('src/frontend/dist','src/backend/dist/public',{recursive:true})\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "release": "release-it"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
